<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EPrint" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/eprint_green</item>
        <item name="colorPrimaryDark">@color/eprint_green_dark</item>
        <item name="colorAccent">@color/eprint_coral</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/eprint_green_dark</item>
        <item name="android:navigationBarColor">@color/eprint_paper</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Android 15+ 边到边模式下系统栏衬底使用的窗口背景色 -->
        <item name="android:windowBackground">@color/eprint_surface</item>
        <!-- 全局按钮保留字体安全区，兼容三星等厂商的 CJK 字体度量。 -->
        <item name="buttonStyle">@style/EPrintButton</item>
    </style>

    <style name="EPrintButton" parent="Widget.AppCompat.Button">
        <item name="android:includeFontPadding">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="EPrintButton.Latin" parent="EPrintButton" />
</resources>
